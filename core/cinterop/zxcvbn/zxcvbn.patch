+/* passphrase-meter patch: dictionaries are not tied to the CRC compiled into dict-crc.h.
+ * Any dictionary produced by dictgen (-b) can be loaded, from a file, a memory buffer or a
+ * file descriptor. Loading replaces a previously loaded dictionary. The header is validated
+ * and all sizes are bounds-checked against the input length, but the trie contents are not:
+ * only load dictionaries from trusted sources. */
+#define DICT_HEADER_WORDS 10
+#define DICT_MAX_FILE_SIZE (64u * 1024u * 1024u)
+
+/* Non-null when DictNodes points into a read-only file mapping instead of a malloc'd block. */
+static void *DictMap;
+static size_t DictMapLen;
