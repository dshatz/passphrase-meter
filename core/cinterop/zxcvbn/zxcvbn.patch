+/**********************************************************************************
+ * Read the dictionary data from an open file descriptor. Offset >= 0 seeks there first
+ * (e.g. Android AssetFileDescriptor.startOffset); Length >= 0 limits how much is read,
+ * Length < 0 reads until EOF. The descriptor is not closed.
+ * Regular files are mapped read-only and used in place (no copy); anything else is read.
+ * Returns 1 on success, 0 on error
+ */
+int ZxcvbnInitFromFd(int Fd, long long Offset, long long Length)
+{
+    size_t Len = 0;
+    uint8_t *Buf;
+    int Mapped;
+    if (Fd < 0)
+        return 0;
+    Mapped = LoadDictMapped(Fd, Offset, Length);
+    if (Mapped >= 0)
+        return Mapped;
+    if (Offset >= 0 && ZX_LSEEK(Fd, Offset, SEEK_SET) < 0)
+        return 0;
+    Buf = ReadAll(Fd, Length, &Len);
+    if (!Buf)
+        return 0;
+    return LoadDictAdopt(Buf, Len);
+}
+
+/**********************************************************************************
+ * Read the dictionary data from the given file (mapped read-only when possible).
+ * Returns 1 on success, 0 on error
+ */
+int ZxcvbnInit(const char *Filename)
+{
+    int Fd, Ok;
+    if (!Filename)
+        return 0;
+    Fd = ZX_OPEN(Filename);
+    if (Fd < 0)
+        return 0;
+    Ok = ZxcvbnInitFromFd(Fd, 0, -1);
+    ZX_CLOSE(Fd); /* a mapping stays valid after closing the descriptor */
+    return Ok;
+}
+
+int ZxcvbnIsInit(void)
+{
+    return DictNodes != 0;
+}
