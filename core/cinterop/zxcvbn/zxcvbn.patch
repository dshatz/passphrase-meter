+/* Takes ownership of a malloc'd Buf holding a whole dictionary file: moves the data over the
+ * header and keeps the block, instead of allocating and copying again. Frees Buf on failure. */
+static int LoadDictAdopt(uint8_t *Buf, size_t Len)
+{
+    unsigned int Hdr[DICT_HEADER_WORDS];
+    uint64_t DictSize = CheckDictHeader(Buf, Len, Hdr);
+    uint8_t *Shrunk;
+    if (!DictSize)
+    {
+        free(Buf);
+        return 0;
+    }
+    memmove(Buf, Buf + sizeof Hdr, (size_t)DictSize);
+    Shrunk = (uint8_t *)realloc(Buf, (size_t)DictSize);
+    if (Shrunk)
+        Buf = Shrunk;
+    SetDict((unsigned int *)Buf, Hdr, 0, 0);
+    return 1;
+}
