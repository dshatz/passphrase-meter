+/* Validates the header of Len bytes of dictionary data and returns the size of the data that
+ * follows it (0 if invalid). */
+static uint64_t CheckDictHeader(const uint8_t *Data, size_t Len, unsigned int Hdr[DICT_HEADER_WORDS])
+{
+    uint64_t DictSize;
+    if (!Data || Len < DICT_HEADER_WORDS * sizeof(unsigned int))
+        return 0;
+    memcpy(Hdr, Data, DICT_HEADER_WORDS * sizeof(unsigned int));
+    if (Hdr[0] != MAGIC)
+        return 0;
+
+    /* Hdr: magic, nodes, child locs, ranks, word ends, child maps, child map entry size,
+     *      large end counts, small end counts, char set size */
+    if (Hdr[1] == 0 || Hdr[1] >= (1<<17))
+        return 0;
+    if (Hdr[2] >= (1<<BITS_CHILD_MAP_INDEX))
+        return 0;
+    if (Hdr[5] >= (1<<BITS_CHILD_PATT_INDEX))
+        return 0;
+    /* dictgen packs each child map into at most 8 bytes, so a node has at most 64 children. */
+    if (Hdr[6] == 0 || Hdr[6] > 8 || (Hdr[6]*8) < Hdr[9] || Hdr[9] >= CHARSET_SIZE)
+        return 0;
+    if (Hdr[7] >= (1<<9))
+        return 0;
+    if (Hdr[8] != Hdr[1])
+        return 0;
+
+    DictSize = (uint64_t)Hdr[1]*sizeof(unsigned int) + (uint64_t)Hdr[2]*sizeof(unsigned int) +
+               (uint64_t)Hdr[3]*sizeof(unsigned short) + Hdr[4] + (uint64_t)Hdr[5]*Hdr[6] +
+               Hdr[7] + Hdr[8] + Hdr[9];
+    if (DictSize == 0 || DictSize > Len - DICT_HEADER_WORDS * sizeof(unsigned int) || DictSize > DICT_MAX_FILE_SIZE)
+        return 0;
+    return DictSize;
+}
+
+/* Replaces the current dictionary with the data at Nodes (validated by CheckDictHeader). The data
+ * is only read, never written, so it may live in a read-only mapping. */
+static void SetDict(unsigned int *Nodes, const unsigned int Hdr[DICT_HEADER_WORDS], void *Map, size_t MapLen)
+{
+    ZxcvbnUnInit();
+    NumNodes = Hdr[1];
+    NumChildLocs = Hdr[2];
+    NumRanks = Hdr[3];
+    NumWordEnd = Hdr[4];
+    NumChildMaps = Hdr[5];
+    SizeChildMapEntry = Hdr[6];
+    NumLargeCounts = Hdr[7];
+    NumSmallCounts = Hdr[8];
+    SizeCharSet = Hdr[9];
+
+    DictNodes = Nodes;
+    ChildLocs = DictNodes + NumNodes;
+    Ranks = (unsigned short *)(ChildLocs + NumChildLocs);
+    WordEndBits = (unsigned char *)(Ranks + NumRanks);
+    ChildMap = (unsigned char*)(WordEndBits + NumWordEnd);
+    EndCountLge = ChildMap + NumChildMaps*SizeChildMapEntry;
+    EndCountSml = EndCountLge + NumLargeCounts;
+    CharSet = (char *)EndCountSml + NumSmallCounts; /* only indexed, never used as a C string */
+    DictMap = Map;
+    DictMapLen = MapLen;
+}
