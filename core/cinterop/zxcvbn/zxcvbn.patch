+/* Maps Length bytes at Offset of Fd read-only and uses them in place.
+ * Returns 1 if loaded, 0 if the data is not a valid dictionary, -1 if it cannot be mapped
+ * (pipe, unsupported, misaligned) and should be read instead. */
+static int LoadDictMapped(int Fd, long long Offset, long long Length)
+{
+    unsigned int Hdr[DICT_HEADER_WORDS];
+    long long Gran, Aligned, Delta;
+    size_t MapLen;
+    uint8_t *Map, *Data;
+#ifdef _WIN32
+    struct _stat64 St;
+    SYSTEM_INFO Si;
+    HANDLE Mapping;
+    if (_fstat64(Fd, &St) != 0 || !(St.st_mode & _S_IFREG))
+        return -1;
+    GetSystemInfo(&Si);
+    Gran = Si.dwAllocationGranularity;
+#else
+    struct stat St;
+    if (fstat(Fd, &St) != 0 || !S_ISREG(St.st_mode))
+        return -1;
+    Gran = sysconf(_SC_PAGESIZE);
+    if (Gran <= 0)
+        return -1;
+#endif
+    if (Offset < 0)
+    {
+        Offset = ZX_LSEEK(Fd, 0, SEEK_CUR);
+        if (Offset < 0)
+            return -1;
+    }
+    if (Length < 0)
+        Length = (long long)St.st_size - Offset;
+    if (Length <= 0 || Offset + Length > (long long)St.st_size || Length > (long long)DICT_MAX_FILE_SIZE)
+        return -1;
+    Aligned = Offset - Offset % Gran;
+    Delta = Offset - Aligned;
+    MapLen = (size_t)(Delta + Length);
+#ifdef _WIN32
+    Mapping = CreateFileMappingW((HANDLE)_get_osfhandle(Fd), NULL, PAGE_READONLY, 0, 0, NULL);
+    if (!Mapping)
+        return -1;
+    Map = (uint8_t *)MapViewOfFile(Mapping, FILE_MAP_READ, (DWORD)((unsigned long long)Aligned >> 32),
+                                   (DWORD)(Aligned & 0xffffffffu), MapLen);
+    CloseHandle(Mapping); /* the view keeps the mapping alive */
+    if (!Map)
+        return -1;
+#else
+    Map = (uint8_t *)mmap(NULL, MapLen, PROT_READ, MAP_PRIVATE, Fd, (off_t)Aligned);
+    if (Map == (uint8_t *)MAP_FAILED)
+        return -1;
+#endif
+    Data = Map + Delta;
+    /* The node tables are read as 32-bit words. */
+    if (((uintptr_t)(Data + sizeof Hdr)) % sizeof(unsigned int) != 0 || !CheckDictHeader(Data, (size_t)Length, Hdr))
+    {
+        int Misaligned = ((uintptr_t)(Data + sizeof Hdr)) % sizeof(unsigned int) != 0;
+#ifdef _WIN32
+        UnmapViewOfFile(Map);
+#else
+        munmap(Map, MapLen);
+#endif
+        return Misaligned ? -1 : 0;
+    }
+    SetDict((unsigned int *)(Data + sizeof Hdr), Hdr, Map, MapLen);
+    return 1;
+}
